}

Lore: {
	Calamity: {
		MushroomMonarchLore: {
			DisplayName: 赤孢皇
			Tooltip: ""
			Lore:
				'''
				即便是最卑微的生物也有其君王。
				泰拉瑞亚的蘑菇们不知出于什么原因，无止境地试图扩张它们的领地。
				有这样的孱弱领袖，它们至今未能如愿也就不奇怪了——即便我的圣战为它们创造了可乘之机。
				'''
		}

		FeudalFungusLore: {
			DisplayName: 真菌帝
			Tooltip: ""
			Lore:
				'''
				尽管它们能施以可怖的掌控，但若说我对它们的本性毫无兴趣，那便是违心之言。
				假若我的圣战能如愿告终，我与那位工程师的关系也未随时间淡去，我定会请他投身于这蘑菇魔法特性的研究。
				'''
		}

		GripsOfChaosLore: {
			DisplayName: 混沌双爪
			Tooltip: ""
			Lore:
				'''
				这些怪异之手常映入我麾下斥候的眼帘。
				我尚不知其本质，但料想它们与泰拉瑞亚上空那邪恶的混沌脱不了干系。
				唯有一点我确信不疑：神灵并非唯一在亵渎这片土地的存在。
				'''
		}

		TruffleToadLore: {
			DisplayName: 松露蟾蜍
			Tooltip: ""
			Lore:
				'''
				这又一次印证了真菌的顽强，以及它们绝不让死者安息的那份执念。
				日久经年，我已看透，此般虚张声势的力量炫耀，不过是弱者拼命想要攫取力量的徒劳挣扎罢了。
				'''
		}

		BroodmotherLore: {
			DisplayName: 育母炎龙
			Tooltip: ""
			Lore:
				'''
				多么奇异的生物，从那燎狱的混沌中诞生，目睹它被斩杀，实属遗憾。
				我曾见过她的女儿。明了这种关系总归有些怪异，但我已学会心怀敬畏。
				从今往后，我定会倍加谨慎。
				'''
		}

		HydraLore: {
			DisplayName: 九头渊蛇
			Tooltip: ""
			Lore:
				'''
				她栖身的那片严苛而混沌的潭渊，曾是一座盛名远扬的居所。
				他们曾是我最忠实的拥护者，他们的覆灭是一场我无力阻止的悲剧。
				无论神祇与否，应为此事负责之人，终有一日将直面我的怒火。
				'''
		}

		DesertDjinnLore: {
			DisplayName: 沙漠巨灵
			Tooltip: ""
			Lore:
				'''
				在巨龙的纪元中，伊尔梅兰海不过是一片黄沙翻涌的荒漠，一个被遗弃种族的故土。
				借我圣战之伟力，它已重获新生。
				如今，那失落文明的幽魂，正自水渊长眠中苏醒。
				命运还真是爱开玩笑，不是吗？
				'''
		}

		SubzeroSerpentLore: {
			DisplayName: 绝零冰蛇
			Tooltip: ""
			Lore:
				'''
				可怜的生灵。
				随着神祇精华与混沌之力侵吞它的栖息地，它已日渐衰弱。
				若这世界当真渴求安宁，此二者皆是必须被涤荡殆尽的祸端。
				'''
		}

		SagittariusLore: {
			DisplayName: 射手座-虚空人马
			Tooltip: ""
			Lore:
				'''
				那些不祥的浮岛……长久以来都是嘉登的执迷所在。
				在他指挥下，我麾下众多研究员钻研着它们所环绕的异象。
				然而他们收获甚微……
				你面对的那台构造体，其构造与我们观察到的其他单位截然不同。
				还有其他人也试图理解这片异常的本质；或许，他们也将在此事中扮演某种角色。
				'''
		}

		SiegeUnitsLore: {
			DisplayName: S.I.E.G.E. 机械单元
			Tooltip: ""
			Lore:
				'''
				如此可笑的构造体，毫无疑问出自风暴科学家之手。
				他们曾是一个个体——风暴元素——但在很久以前便分裂成了一个更大的组织。
				他们所谓的创新简直可笑；就连这些破破烂烂的机器都明显抄袭了嘉登的失败之作。
				傲慢终将是他们覆灭的根源。
				'''
		}

		OrthrusXLore: {
			DisplayName: 俄耳托斯X型
			Tooltip: ""
			Lore:
				'''
				这粗劣的机械造物就是风暴科学家的最后防线？
				何其可悲。
				我毫不怀疑，我的寻神骑士能轻易将其碾为一堆废铁。
				'''
		}

		RaiderUltimaLore: {
			DisplayName: 创世哺育之母
			Tooltip: ""
			Lore:
				'''
				我早听闻过这台攻坚单位的传闻。
				手下的步兵，确实曾数次在它面前溃不成军。
				如今见你将其解决……看来我不在的这段时日，我的士兵们着实变得软弱了。
				'''
		}

		RetrieverLore: {
			DisplayName: 捕猎者
			Tooltip: ""
			Lore:
				'''
				以一只手的形态来设计回收单元……真是可悲。
				尽管设计拙劣，它确实能够进入那异象之中。
				我毫不怀疑，风暴科学家对自己无法理解的事物横加干涉，最终只会酿成恶果。
				'''
		}

		AnubisLore: {
			DisplayName: 史诗记述者
			Tooltip: ""
			Lore:
				'''
				直至近日，我也只在骑士们的一些模糊的传言中听闻他的传说。
				在那场大焚尽之后，我震惊地发现他竟活生生地站在我的宫廷前。
				他发出了一个警告：将有一人崛起，终结我的统治。
				看来，他在你身上看到了摧毁我的手段。
				唯有时间，才能道尽这段传说的结局……
				'''
		}

		AthenaLore: {
			DisplayName: 雅典娜
			Tooltip: ""
			Lore:
				'''
				六翼天使是相当独特的一群，在大没落之前，他们常与克里萨甸人来往。
				如今却深居简出，全仰仗其女王的庇护。
				如果这就是远古一族仅剩的模样，那可太令我失望了。
				'''
		}

		GreedLore: {
			DisplayName: 金食饕餮
			Tooltip: ""
			Lore:
				'''
				这是什么……？又一条像……他那样的蠕虫？
				不可能。除了那吞噬者，其余早已被肃清殆尽——因为他逃进了——
				……嗯……倘若，他并非唯一拥有那种能力的存在呢……？
				'''
		}

		RajahRabbitLore: {
			DisplayName: 巨兔王公
			Tooltip: ""
			Lore:
				'''
				一位高贵的战士，王公是值得尊敬的对手。
				在我的征服之路上，他曾以同样的理由挑战我，一如他找上你；我应承了他的邀请，并在决斗中将他击败。
				他靠着纯粹的毅力活了下来，再次向我发起挑战，渐渐地我们达成了共识。
				我们并非殊途——皆为含冤而逝者的复仇之人。我们的羁绊日益牢固，刀锋相交的次数也愈发频繁。
				嘉登曾声称他是间谍，在研究我的行动以期有朝一日将我刺杀，但他错了。他永远无法理解两名对手之间的惺惺相惜。
				尽管早已分道扬镳，我却深知他的底细：那远非他全部的实力。庆幸他的仁慈吧，祈祷他不会以全力之怒降临于你。
				'''
		}

		ForsakenAnubisLore: {
			DisplayName: 逝落的断罪师 阿努比斯
			Tooltip: ""
			Lore:
				'''
				看来，阿努比斯选择让你一窥他真正的实力了。
				当他决意对抗我时，毋庸置疑是以最强之姿。
				即便如此，我亦毫无畏惧。这与我在面对至高叛徒时所目睹的力量相比不值一提。
				若想与我匹敌，你还需变得更强才行。
				'''
		}

		OlympianAthenaLore: {
			DisplayName: 奥林匹亚雅典娜
			Tooltip: ""
			Lore:
				'''
				我曾以为雅典娜在你们初次交锋时有所保留。
				这便是瓦里安一族的真正力量……岁月虽已使他们的族裔凋零至此，但仍有余勇可嘉。
				我在想，若他们在巨龙最后的战斗中施以援手，命运是否会织就不同的故事……？
				'''
		}

		WormKingGreedLore: {
			DisplayName: 鎏金万蟲王
			Tooltip: ""
			Lore:
				'''
				我的推测得到了证实……
				毋庸置疑。那条鎏金蠕虫，正是吞噬者的同族。
				但如果这是真的，那么……
				那股扭曲之力究竟在暗中影响这些土地多久了……？
				'''
		}

		EquinoxWormsLore: {
			DisplayName: 昼夜双虫
			Tooltip: ""
			Lore:
				'''
				我们的世界知晓许多源自星辰的蠕虫，这两条亦不例外。
				因他们的仁慈，我们的世界得以享有白昼与黑夜。
				他们与诸神截然相反，倾其所有只为吾辈的繁盛。
				传说中甚至提及它们曾与一位英雄并肩作战，驱逐混沌之力。
				正是那位英雄，激励我执起刀刃，踏上远征之路。
				'''
		}

		SistersOfDiscordLore: {
			DisplayName: 混沌姐妹
			Tooltip: ""
			Lore:
				'''
				那俩真是相当恼人的一对。
				我毫不怀疑，沉默的那位已经暗中监视圣战许久了。
				同样，那位法师也在多次场合下袭击了我的部队。我听说她渴望与硫火女巫一对一较量。
				即便联手，我亦怀疑她们能否在那种遭遇中生还。
				'''
		}

		AkumaLore: {
			DisplayName: 凶煞恶魔
			Tooltip: ""
			Lore:
				'''
				邪鬼巨龙……
				我的部队推进燎狱的任何尝试都被它的烈焰迅速击退。
				正是他造就了燎狱：从他的火焰中诞生，将曾称此地为家的文明化为焦土。
				谨记，你在此时取得的胜利不过是暂时的。凶煞恶魔的愤怒之魂至今犹存。
				而我所惧的是，他们真正的力量仍在沉眠……静待觉醒之机。
				'''
		}

		YamataLore: {
			DisplayName: 惊惧梦魇
			Tooltip: ""
			Lore:
				'''
				惊惧梦魇……
				我的部队不敢踏入潭渊半步，他那致命的毒素令所有踏入者窒息而亡。
				正是他造就了潭渊：从他的毒素中诞生，扼杀了曾称此地为家的文明。
				谨记，你在此时取得的胜利不过是暂时的。八歧大蛇的怨怒之魂仍在延续。
				而我所惧的是，他们真正的力量仍在沉睡……静待觉醒之机。
				'''
		}

		ZeroLore: {
			DisplayName: 零械单元
			Tooltip: ""
			Lore:
				'''
				末日构造体……
				嘉登长期以来都对这单位着迷不已。它的护盾将他所有的破解尝试尽数阻挡在外。
				看来，唯有你能够启动它。
				当心了。
				那求救信号——如果嘉登对那异象的研究可信的话……
				你已将灾难引到了我们的门阶之上。
				'''
		}

		ChampionRajahRabbitLore: {
			DisplayName: 无辜的保护者
			Tooltip: ""
			Lore:
				'''
				我本以为王公作为无辜的保护者的岁月将远超于我，然而我错了。
				如今，你承袭了他的名号，而他如同我一般隐退归田。
				在他全力之下胜出绝非小事；你或许已经准备好面对我了。
				在接下来的战斗中凯旋而归吧，那一刻很快就将到来。
				'''
		}

		ShenDoragonLore: {
			DisplayName: 上神应龙
			Tooltip: ""
			Lore:
				'''
				难以想象，凶煞恶魔与惊惧梦魇竟只是同一存在的两半……
				即便如此，我仍忍不住怀疑，那也远非他全部的力量。
				在古老的传说中，我曾听过一位英雄与冥昧化身交战的故事。
				然而那故事中描绘的并非龙形，而是一名男子……真令人好奇……
				'''
		}

		InfinityZeroLore: {
			DisplayName: 无限零
			Tooltip: ""
			Lore:
				'''
				嘉登对那异象的了解也仅限于无限零。
				没想到它如此强大，却也不过是一具承载着更大威胁的躯壳。
				遗忘……我恐怕曾在描述宇宙创生的远古经卷中见过这个名字。
				四尊无可估量的泰坦……
				难道这就是经卷中提及的熵之化身……？
				'''
		}

		SoulOfCthulhuLore: {
			DisplayName: 克苏鲁之魂
			Tooltip: ""
			Lore:
				'''
				巨龙一族的陨落……莫非当年并非只有一头畸变巨兽，而是两头……？
				如果那个不可名状的魂魄所言属实，那事实必定如此，可为何独独这一段往事从未有人向我提起……？
				在我钻研龙族语言时，我了解到"克苏鲁"意为"巨兽"。
				或许这个称号正是因这孪生巨兽而生……
				'''
		}
	}
}

InfinityGauntlet: {
	DisplayName: 无限手套
	Tooltip: ""
