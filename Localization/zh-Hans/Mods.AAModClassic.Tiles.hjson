	MapEntry: 厄劫倒计时钟

	FlavorText: {
		PreZero:
			'''
			时钟正在倒计时，指向某件事……不过你并不清楚那究竟是什么。
			目前的数字大到连这个数字叫什么你都不知道。
			'''
		PostZero: 时钟上只显示一个数字：0
	}
}

