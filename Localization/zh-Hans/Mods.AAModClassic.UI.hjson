Removed: {
	Title: 已移除
	Description: 体验远古觉醒旧版本中的已移除内容。
}

Unreleased: {
	Title: 未发布
	Description: 体验远古觉醒旧版本开发时的未发布的内容。
}

Unofficial: {
	Title: 非官方
	Description: 享受更加流畅的体验，包含改进与新增内容。
}

WindowTitle: {
	0: 远古觉醒：小家伙们累坏了
	1: 远古觉醒：迷失在茫茫大海……
	2: 远古觉醒：杀手将至
	3: 远古觉醒：在冥昧地狱中焚烧
	4: 远古觉醒：中号石头
	5: 远古觉醒：也试试远古觉醒！
	6: 远古觉醒：快把发光贴图藏起来！
	7: 远古觉醒：备受期待的前传！
	8: 远古觉醒：砰。砰。砰。砰。
	9: 远古觉醒：……不，远古沉睡。
	10: 远古觉醒：也试试震颤！
	11: 远古觉醒：Chungus Land事件
	12: 远古觉醒：也试试Valcodix
	13: 远古觉醒：克苏鲁怒了……而且少了一缕魂！
	14: 远古觉醒：He is the storm that is approaching！
	15: 远古觉醒：阿努比斯的午夜惊魂
	16: 远古觉醒：设定严谨
	17: 远古觉醒：也试试元素觉醒！
	18: 远古觉醒：完整移植，只为你的快乐
	19: 远古觉醒：光明但黑暗的未来正在展开……
}

Quests: {
	LegendscribeEarlyGame: {
		MushroomMonarch: {
			Name: 蘑菇。我是认真的。

			Description: {
				Incomplete: 嘿，你看到这些满地都是的小红蘑菇没？我听说，要是你抓上一把捏碎，再拿在手里挥一挥，它们的蘑菇王还是什么的就会冲出来，追着你撞。这我可得亲眼瞧瞧。
				Complete: …就这？
			}

			Tasks: - 击败赤孢皇
		}

		FeudalFungus: {
			Name: 更多蘑菇。

			Description: {
				Incomplete: 那发光的蘑菇洞穴，不知为什么，每次进去都搞得我晕乎乎的。话说回来，想提升魔法能力吗？那底下有个大蘑菇怪物，体内融合了很棒的魔法力量。下去的时候记得捏住鼻子。
				Complete: 干得漂亮。老实交代，你现在是不是上头了？
			}

			Tasks: - 击败真菌帝
		}

		GripsOfChaos: {
			Name: 管好爪子

			Description: {
				Incomplete: 晚上那些飞来飞去的爪子简直是噩梦，吓得我毛都竖了。在我的旅途中，我碰到过两只超——大的。如果你把它们干掉，小的也许就不来烦人了。多宰几只小的，再拿着它们的掉落物比划比划，说不定能把它们召唤下来。
				Complete: 干得漂亮，收拾掉那两只巨手了。或许那些小的终于能放过我了。
			}

			Tasks: - 击败混沌双爪
		}

		Broodmother: {
			Name: 笨重的肥龙

			Description: {
				Incomplete: 喜欢龙吗？不喜欢？那可惜了。想要更好的装备？那你得去宰一头超——大的熔岩龙。她个头大、模样吓人，还肥——得简直飞不起来，虽然人家照样飞给你看。
				Complete: 那是我这辈子见过最肥的龙。
			}

			Tasks: - 击败育母炎龙
		}

		Hydra: {
			Name: 三头怪胎

			Description: {
				Incomplete: 潭渊向来是所有恶心蜥蜴的聚集地，但那里有一条超级大的，有三个头。她脾气特别暴躁，每次我想进她的巢穴，她都想着要吃了我！
				Complete: 走好不送。那条九头蛇就是不肯消停。至少她女儿稍微温和一些…嗯？谁？以后再说，干得好。
			}

			Tasks: - 击败九头渊蛇
		}

		DesertDjinn: {
			Name: 三个愿望

			Description: {
				Incomplete: 那个狗娘养——哦嗨。抱歉，刚才被一只沙漠巨灵气得够呛。那个会魔法的肌肉蠢货和他的喽啰老在我面前秀肌肉。你能不能去帮我教训教训他们？
				Complete: 哈！现在知道谁才是老大了吧，这沙包怂货！
			}

			Tasks: - 击败沙漠巨灵
		}

		SubzeroSerpent: {
			Name: 冷酷如冰

			Description: {
				Incomplete: 蛇！怎么偏偏又是蛇啊！我恨死它们了！算了，最近冻原那边有些雪蛇老缠着我不放。你能不能当回灭蛇专家，去瞧瞧它们到底在搞什么名堂？
				Complete: 希望你没有被"冻成冰棍儿"！*咚咚锵*…好吧我知道这很冷。
			}

			Tasks: - 击败绝零冰蛇
		}

		Sagittarius: {
			Name: 马戏

			Description: {
				Incomplete: 你知道虚空吗？就是东边那些阴森森的浮空岛？我发誓我看到一匹机械马在那附近飞来飞去，吓得我浑身发毛！我在想，你能不能帮我搞定那个铁皮罐头？
				Complete: 搞定那匹马了，干得漂亮。不知道为什么，我突然觉得好饿…
			}

			Tasks: - 击败虚空人马
		}

		Retriever: {
			Name: 逮到你了

			Description: {
				Incomplete: 还记得混沌双爪吗？那双恶心的抓抓手？现在有个机械版的，还老偷我的东西。能不能帮我个忙，去朝它扔个扳手什么的？
				Complete: 你顺便拿回我的《传奇狗阿努比斯的生命史诗历险记》第三版了吗？
			}

			Tasks: - 击败捕猎者 电子猎犬爪
		}

		OrthrusX: {
			Name: 两个头；零个脑子

			Description: {
				Incomplete: 还记得九头蛇吗？外面还有一条更大的。而且是机器版的。而且它呃…会放电。所以呃…祝你好运！
				Complete: 看来食腐者现在成了盘中餐了。
			}

			Tasks: - 击败食腐者 双头狗俄耳托斯X型
		}

		RaiderUltima: {
			Name: 机械大块头

			Description: {
				Incomplete: 有人说在某天夜里看到个奇怪的影子。那家伙大得连月亮都给遮住了一小会儿。你得去查查这怪事，然后解决掉它。
				Complete: 所以说果然是个巨型机器人？好吧，有时候人就是想太多了。那玩意儿几乎跟育母炎龙一样肥。
			}

			Tasks: - 击败侵入者 创世哺育之母
		}

		Anubis: {
			Name: 审判之古者

			Description: {
				Incomplete: 我听说有个掌管典籍的家伙，浑身肌肉还长得贼帅，所有女士都为他那出神入化的灵魂审判能力神魂颠倒。真是个了不起的家伙。
				Complete: 你下手可以轻一点的，知道吧。我的背现在还疼着呢。
			}

			Tasks: - 击败阿努比斯 史诗记述者
		}

		Athena: {
			Name: 聒噪性头痛

			Description: {
				Incomplete: 你知道天上那些尖叫的鹰身女妖吧？这倒好，还有一群更讨人嫌的，叫六翼天使，简直 闭 不 上 嘴！！！她们在东边那个空中宫殿里有个头领。也许你上去揍她个满地找牙，她们就能闭上那张鸟嘴了。
				Complete: 谢天谢地，你总算让那些叽叽喳喳的小东西闭嘴了！它们要是再朝我尖叫一声，我真会抓一只串在烤叉上，直接当炸鸡晚餐吃。
			}

			Tasks: - 击败雅典娜
		}

		Greed: {
			Name: 好一条蠕虫

			Description: {
				Incomplete: 嘿呃，地下有一个超大的宝藏堆，里面有很多金子，但被一条超吝啬的蠕虫守着。你应该去那儿看看，能捞一大堆财宝，不过呃…下面有我的东西。你能去帮我拿回来吗？放心，你只要瞧见，立马就知道那是我的。
				Complete: 嘿，呃…你找到我那东西没？还没有？就在下面那堆战利品里再翻翻，肯定在里头。
				FoundBook: 嘿，谢谢你帮我把书拿回来。金食饕餮前阵子把它偷了，估计是因为我用来装订的金色镶边太惹眼了。去那个洞穴里再翻翻吧，说不定他还偷了别的东西？
			}

			Tasks: - 击败金食饕餮
		}

		Rajah: {
			Name: 蹦跳小混混

			Description: {
				Incomplete: 嘿，你知道那些到处蹦蹦跳跳的兔子吗？我呃…我是你的话就不会去惹它们。这附近有个传说，说是有个类似"守护者"的存在保护着它们免受伤害。为什么是传说？因为好像跟那东西交过手的人就没活着回来的。挺有意思的故事，对吧？
				Complete: 你打败了巨兔王公？噗，对，你吹吧，我可是亲眼见过他把所谓的神明都揍得屁滚尿流，你不可能打得过他！
			}

			Tasks: - 击败巨兔王公
		}
	}

	LegendscribeLateGame: {
		ForsakenAnubis: {
			Name: 我要求再战一场。

			Description: {
				Incomplete: 我要再战一场，{0}。不是因为我的自尊心。我得确认你已经为接下来的事情做好了准备。来沙漠找我，再战一次。做好准备。
				Complete: 干得不错，伙计。我确实挺惊讶的，虽然我还是放了水。嗯？我的全力？就像我之前说的，有些东西为了你好还是别碰为妙。
			}

			Tasks: - 击败阿努比斯 逝落的断罪师
		}

		AthenaA: {
			Name: 鹰身鸟妖又来了

			Description: {
				Incomplete: 嘿，那个烦人的小鸟妖找到你了吗？对不住，是我告诉她的，她在我耳朵边上一直叫，烦死了。总之，看来雅典娜想再战一场。小心点，伙计。这感觉像个陷阱…
				Complete: 嗯？你问瓦里安是哪些人？这个名字我可有年头没听过了…久到我都快记不起来了。不过我隐约记得，好像还有另一个人在什么地方晃悠着…
			}

			Tasks: - 击败奥林匹亚女武神 雅典娜
		}

		GreedA: {
			Name: 财富与安息

			Description: {
				Incomplete: 你知道吗，我隐约记得那个"喜欢偷鸡摸狗的贪财家伙"的一件事。那家伙刚在这片地界露面的时候，可比后来你揍他屁股时强太多了。难道他越老越弱了…？还是说…不，那绝不可能。
				Complete: 所以他一直都在隐藏自己真正的实力。不过我想知道为什么…难道他是在躲什么东西…？
			}

			Tasks: - 击败金食饕餮 鎏金万蟲王
		}

		Equinox: {
			Name: 又是蠕虫Boss，该死。

			Description: {
				Incomplete: 喜欢蠕虫吗？我也不喜欢，但你猜怎么着？有两条大蠕虫控制着昼夜的流转，而且它们可难缠了。祝你好运。
				Complete: 干掉那对昼夜双虫了，漂亮。我能看出来你做到了，因为现在好像过了一周了。希望我没错过护士的预约。
			}

			Tasks: - 击败昼夜双虫
		}

		Sisters: {
			Name: 可怕的双胞胎

			Description: {
				Incomplete: 还记得育母炎龙和九头渊蛇吗？那俩都有女儿。天哪，她们烦死人了！！！每次我去混沌生态群系，这俩就专等着坏我好事！你能去教训教训她们吗？
				Complete: 漂亮，你给那两个被宠坏的臭丫头好好上了一课！她俩完全没料到会栽跟头！
			}

			Tasks: - 击败混沌姐妹
		}

		Akuma: {
			Name: 狂怒之古者

			Description: {
				Incomplete: 为什么会有人把一条太阳蛇叫做恶魔？我也不知道…但邪鬼巨龙必须得滚蛋。他老用火焰吐息把我的沙漠烧成玻璃，气死我了。
				Complete: 邪鬼巨龙自以为很酷。在我眼里，他就是装逼装过头然后翻车的那种。不说这个了，你最好去用水冲冲头发。你头上有点烤焦了。
			}

			Tasks: - 击败邪鬼巨龙
		}

		Yamata: {
			Name: 怨怒之古者

			Description: {
				Incomplete: 八歧大蛇，那个爱发牢骚的蠢货！他对什么都抱怨个没完，还就——是——闭——不——上——嘴！讲真的，同时应付七个叽叽喳喳吵得要死、还互相抢着说话的头，换你你受得了吗！
				Complete: 谢谢你让那个七个头的娘炮闭嘴。那家伙烦得我真想把自己的毛都扯光。
			}

			Tasks: - 击败八歧大蛇
		}

		Zero: {
			Name: 末日之古者

			Description: {
				Incomplete: 你见过虚空里那个一直飘在那儿的又大又吓人的铁家伙了吧？总之，你干翻月亮领主之后，我听见虚空那边轰的一声巨响。你能去帮我看看吗？
				Complete: …说实话。那东西死掉之后说的话，让我浑身不舒服。
			}

			Tasks: - 击败零械单元
		}

		Shen: {
			Name: 冥昧末日的预言者

			Description: {
				Incomplete: 邪鬼巨龙和八歧大蛇…你知道吗，那俩曾经是一体的。而且天哪，那个合体形态强得离谱，有一次直接夷平了两个文明。总之，你找我有什么事来着？
				Complete: 天哪——我就知道你能行，兄弟！干得漂亮！不过…你把他打趴下的时候，他看起来好像气得要命…简直跟他当初被——呃，算了，当我没说。
			}

			Tasks: - 击败上神应龙
		}

		InfinityZero: {
			Name: 机械恶意

			Description: {
				Incomplete: 嘿，你还记得零械被你拆了之后嘟囔的那堆东西吧？是啊……看来我们担心得没错。一台巨型机器穿过那道你大概也注意到了的大裂口，扭曲着传送到了虚空里。你要是打算最近去那边转悠，我劝你小心点……
				Complete: 哇——你居然把那玩意儿打败了？里面还住着什么东西，是吧？你还说它只是想一个人待着……不可能……那该不会是——呃，这事先放放，以后再说。
			}

			Tasks: - 击败无限零
		}

		SoulOfCthulhu: {
			Name: 寰宇之灾

			Description: {
				Incomplete: 你最近去过海边吗？整片海洋都被一股诡异的浓雾给吞没了！现在想想，我记得不久前那边好像沉过一艘船。不知道这两件事有没有关联……？
				Complete: 你居然打败并杀死了克苏鲁之魂？！天哪，那可真是了不起。不过它临死前念叨的那些诅咒让我很不安……阿撒托斯……但愿那只是虚张声势。
			}

			Tasks: - 击败克苏鲁之魂
		}
	}
}
