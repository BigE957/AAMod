LovecraftiansResearchList: {
	DisplayName: Lista De Investigación Del Lovecraftiano
	Tooltip:
		'''
		¡Necesito estas cosas, por favor!
		1. Algo de esa biosfera subterránea. Un cristal de ella podría servir...
		2. Muestras de carne de la corrupción. Quiero ver de qué están hechas esas cosas.
		3. Una muestra de hueso del carmesí. Me pregunto cómo funciona su estructura ósea.
		4. Encuentra lo que sea que coman las criaturas en el Lodazal. Solo mátalas hasta que una suelte su comida o algo así.
		5. Una escama de algo en el Infierno. Estoy intentando averiguar cómo estas cosas son tan resistentes al fuego.
		6. Muestras de esporas de la selva. Estos champiñones son muy molestos, tal vez pueda hacer algo para acabar con ellos.
		7. Algún tipo de parte de criatura que inyecte veneno o algo así. Mi jeringa se rompió y esa enfermera no me deja usar ninguna de las suyas.
		8. Una muestra de lo que sea que estén hechos el Monarca Fúngico y el Hongo Feudal. Aunque podría necesitar algo de ayuda para estudiar esto...
		9. Un trozo de chatarra de esas islas flotantes al oeste de aquí. Ese material parece interesante para fabricar equipo.
		10. Una máquina de hielo sería bastante agradable de tener.
		11. Conejos. No para fines de pruebas, solo pienso que son lindos y quiero un par como mascotas.
		12. Algo brillante de la Bendición. Me pregunto si puedo usarlo para hacer más pociones...
		'''
}

MadnessMushroom: {
	DisplayName: Champiñón de la Locura
	Tooltip:
		'''
		Un champiñón sumamente raro
		¿Quizás el Hombre Champiñón sepa qué hacer con él?
		'''
}

GravitySphere: {
	DisplayName: Esfera de Gravedad
	Tooltip: ¡Un modelo de piedra del planeta, completo con una luna en órbita!
}

StarChart: {
	DisplayName: Carta Estelar
	Tooltip: Un mapa del sistema solar hasta este planeta.
}

WormIdol: {
	DisplayName: Ídolo de Gusano
	Tooltip:
		'''
		Una estatua antigua que representa alguna forma de dios gusano.
		Parece que no ha sido tocada en años
		'''
}

GS: {
	DisplayName: G S
	Tooltip: ""
}

SC: {
	DisplayName: S C
	Tooltip: ""
}

GlitchFish: {
	DisplayName: Pez Glitch
	Tooltip: ""
}

Lore: {
	Calamity: {
		MushroomMonarchLore: {
			DisplayName: Monarca Fúngico
			Tooltip: ""
			Lore:
				'''
				Incluso los seres simples tienen sus reyes.
				Por razones que no pretendo conocer, los champiñones de Terraria buscan expandir su alcance sin fin.
				Con líderes tan débiles como este, no es de extrañar que no lo hayan logrado, incluso con las ventajas que mi cruzada podría haber proporcionado.
				'''
		}

		FeudalFungusLore: {
			DisplayName: Hongo Feudal
			Tooltip: ""
			Lore:
				'''
				A pesar del espantoso control que pueden ejercer, sería deshonesto de mi parte decir que no encuentro su naturaleza fascinante.
				Si mi cruzada hubiera terminado correctamente, y mi relación con el ingeniero no se hubiera desvanecido, le habría pedido que se dedicara al estudio de las propiedades mágicas del champiñón.
				'''
		}

		GripsOfChaosLore: {
			DisplayName: Garras del Caos
			Tooltip: ""
			Lore:
				'''
				Estas extrañas manos son un avistamiento común entre mis exploradores.
				Su naturaleza me es desconocida, pero asumo que están relacionadas con el malvado caos sobre Terraria.
				Una cosa sé con certeza: los dioses no son lo único que profana esta tierra.
				'''
		}

		TruffleToadLore: {
			DisplayName: Sapo de Trufa
			Tooltip: ""
			Lore:
				'''
				Otra demostración de la tenacidad de los hongos y de su renuncia a dejar descansar a los muertos.
				Con el tiempo, he aprendido que desfiles de poder como estos son meramente los débiles intentando desesperadamente alcanzar la fuerza.
				'''
		}

		BroodmotherLore: {
			DisplayName: La Madre de la Camada
			Tooltip: ""
			Lore:
				'''
				Qué criatura tan curiosa, nacida de ese caos infernal, una pena verla asesinada.
				He conocido a su hija antes, una relación extraña de la que ser consciente, pero una que aprendí a tratar con respeto.
				Andaría con cuidado de ahora en adelante.
				'''
		}

		HydraLore: {
			DisplayName: La Hidra
			Tooltip: ""
			Lore:
				'''
				El duro y caótico lodazal al que llama hogar fue una vez un asentamiento de gran renombre.
				Ellos fueron mis más ávidos partidarios, y su destrucción fue una tragedia que no pude evitar.
				Sea un dios o no, quienquiera que sea el responsable encontrará algún día mi ira.
				'''
		}

		DesertDjinnLore: {
			DisplayName: Genio del Desierto
			Tooltip: ""
			Lore:
				'''
				Una vez, en la era de los Dragones, el Mar de Ilmera no era más que un desierto azotado por la arena y el hogar de una casta olvidada.
				Por la mano de mi Cruzada, ha sido restaurado.
				Ahora, los espíritus de esa civilización olvidada se despiertan de su sueño ahogado por el agua.
				Un extraño giro del destino, ¿no es así?
				'''
		}

		SubzeroSerpentLore: {
			DisplayName: Serpiente Subcero
			Tooltip: ""
			Lore:
				'''
				Una pobre criatura.
				Parece que se ha debilitado a medida que la esencia divina y las fuerzas caóticas invaden su hábitat.
				Ambas son plagas que deben ser erradicadas si este mundo quiere conocer la paz alguna vez.
				'''
		}

		SagittariusLore: {
			DisplayName: Sagitario
			Tooltip: ""
			Lore:
				'''
				Esas islas ominosas... Han sido durante mucho tiempo una fascinación de Draedon.
				Gran parte de mis investigadores bajo su mando han estudiado la anomalía que rodean.
				Sin embargo, incluso ellos han aprendido poco...
				El constructo al que te enfrentaste, su construcción es única en comparación con los otros que hemos observado.
				Hay otros que buscan comprender la naturaleza de esta anomalía; tal vez tengan un papel que desempeñar en esto.
				'''
		}

		SiegeUnitsLore: {
			DisplayName: Las Unidades de Asedio
			Tooltip: ""
			Lore:
				'''
				Qué constructos tan ridículos, estos son sin duda los productos de los Fulgurianos.
				Alguna vez fueron un solo ser, la Elemental de la Tormenta, aunque se separaron hace mucho tiempo en una organización más grande.
				Sus intentos de innovación son lamentables; incluso estas máquinas defectuosas reflejan claramente su inspiración en los propios fracasos de Draedon.
				La arrogancia será sin duda su perdición.
				'''
		}

		OrthrusXLore: {
			DisplayName: Orthrus X
			Tooltip: ""
			Lore:
				'''
				¿Esta tosca maquinación es realmente la última línea de defensa de los Fulgurianos?
				Qué lamentable.
				No tengo ninguna duda de que mis Caballeros Buscadores de Dioses podrían reducirla a poco más que chatarra con facilidad.
				'''
		}

		RaiderUltimaLore: {
			DisplayName: Raider Ultima
			Tooltip: ""
			Lore:
				'''
				Había oído rumores de esta Unidad de Asedio.
				De hecho, miembros de mi infantería han sido derrotados por ella en un puñado de ocasiones.
				Verte acabar con ella... Mis soldados claramente se han vuelto blandos en mi ausencia.
				'''
		}

		RetrieverLore: {
			DisplayName: El Recolector
			Tooltip: ""
			Lore:
				'''
				Construir una unidad de recuperación con forma de mano... Es casi lamentable.
				A pesar de la falta de diseño, de hecho es capaz de entrar en la anomalía.
				No tengo ninguna duda de que la intromisión de los fulgurianos en aquello que no entienden solo puede terminar mal.
				'''
		}

		AnubisLore: {
			DisplayName: El Escriba de Leyendas
			Tooltip: ""
			Lore:
				'''
				Hasta hace poco, solo había oído mitos murmurados entre mis Caballeros sobre el Escriba de Leyendas.
				Después de la Gran Incineración, me sorprendió encontrarlo de pie ante mi corte en carne y hueso.
				Emitió una advertencia: uno se levantaría para poner fin a mi reinado.
				Parece ser que ve en ti los medios para destruirme.
				El tiempo será el único que dirá cómo termina esta fábula...
				'''
		}

		AthenaLore: {
			DisplayName: Atenea
			Tooltip: ""
			Lore:
				'''
				Una cohorte bastante peculiar, se sabía que los serafines se mezclaban con los chrysadianos antes de la Caída.
				Ahora se han convertido en ermitaños huraños, confiando en la protección de su Reina.
				Si esto es todo en lo que se han convertido los Antiguos, entonces estoy profundamente decepcionado.
				'''
		}

		GreedLore: {
			DisplayName: Avaricia
			Tooltip: ""
			Lore:
				'''
				¿Qué es esto...? ¿Otro gusano como... él?
				Imposible, todos fueron purgados a excepción del Devorador porque escapó hacia un...
				...hm... ¿y si él no fuera el único con esa habilidad...?
				'''
		}

		RajahRabbitLore: {
			DisplayName: Rajah Rabbit
			Tooltip: ""
			Lore:
				'''
				Un noble guerrero, Rajah es un rival digno.
				Durante mi conquista, me desafió por la misma razón por la que te buscó a ti; acepté su invitación y lo vencí en un duelo.
				Sobrevivió por puro coraje, desafiándome una vez más, y llegamos a entendernos.
				No éramos tan diferentes, vengadores de los caídos injustamente. Nuestro vínculo se hizo más fuerte y nuestras hojas se cruzaron muchas veces más.
				Draedon afirmó una vez que era un espía, estudiando mis movimientos para matarme algún día, pero se equivocaba. Él nunca podría entender el respeto mutuo de dos rivales.
				A pesar de habernos distanciado, lo conozco bien: esto estuvo lejos de ser la totalidad de su poder. Agradece que haya sido misericordioso y espera que no desate toda su furia contra ti.
				'''
		}

		ForsakenAnubisLore: {
			DisplayName: Juez Abandonado, Anubis
			Tooltip: ""
			Lore:
				'''
				Así que Anubis decidió mostrarte un vislumbre de lo que realmente es capaz.
				Cuando decidió oponerse a mí, fue sin duda en su momento más fuerte.
				Incluso entonces, no sentí miedo. Esto no fue nada comparado con el poder que presencié al enfrentarme al Traidor Todopoderoso.
				Necesitarás hacerte aún más fuerte si esperas estar a mi altura.
				'''
		}

		OlympianAthenaLore: {
			DisplayName: Atenea Olímpica
			Tooltip: ""
			Lore:
				'''
				Había pensado que era posible que Atenea se estuviera conteniendo en su primer combate.
				Así que ese es el verdadero poder de un Varian... El tiempo ha desgastado a su especie haciéndola escasa, pero aún les queda lucha dentro.
				Me pregunto, si hubieran ayudado a los Dragones en su lucha final, ¿podría el destino haber hilado una historia diferente...?
				'''
		}

		WormKingGreedLore: {
			DisplayName: Rey Gusano Avaricia
			Tooltip: ""
			Lore:
				'''
				Mi especulación ha demostrado ser correcta...
				No puede haber duda. Ese gusano dorado es de hecho un pariente del Devorador.
				Pero si eso es cierto, entonces...
				¿Durante cuánto tiempo ha estado influyendo la calaña de la Distorsión en estas tierras...?
				'''
		}

		EquinoxWormsLore: {
			DisplayName: Los Gusanos del Equinoccio
			Tooltip: ""
			Lore:
				'''
				Nuestro mundo conoce muchos gusanos de origen cósmico, y estos dos no son una excepción.
				A través de su benevolencia, nuestro mundo es dotado con el Día y la Noche.
				Son el polo opuesto de los Dioses. Se dedican a nuestra prosperidad.
				Las leyendas incluso hablan de ellos luchando junto a un héroe para desterrar a las fuerzas del Caos.
				Es ese héroe el que me inspiró a empuñar mi hoja y comenzar mi Cruzada.
				'''
		}

		SistersOfDiscordLore: {
			DisplayName: Las Hermanas de la Discordia
			Tooltip: ""
			Lore:
				'''
				Un par bastante molesto son esas dos.
				No tengo dudas de que la silenciosa ha estado espiando las operaciones de la Cruzada desde hace algún tiempo.
				Asimismo, la maga ha atacado a mis tropas en múltiples ocasiones. He oído que desea enfrentarse a la Bruja de Azufre cara a cara.
				Dudo que incluso como equipo sobrevivieran a tal encuentro.
				'''
		}

		AkumaLore: {
			DisplayName: Akuma
			Tooltip: ""
			Lore:
				'''
				El Demonio Dracónico...
				Cualquier intento de mis fuerzas por adentrarse en el Infierno fue repelido rápidamente por sus llamas.
				Fue él el responsable del Infierno: nacido de sus llamas, arrasando la civilización que una vez llamó hogar a esa región.
				Ten cuidado, tu victoria aquí es solo temporal. El espíritu furioso de Akuma perdura incluso ahora.
				Y temo que su verdadero poder aún duerme... Esperando a ser despertado.
				'''
		}

		YamataLore: {
			DisplayName: Yamata
			Tooltip: ""
			Lore:
				'''
				La Pesadilla del Terror...
				Mis fuerzas no se atrevieron a poner un pie en el Lodazal, sus viles toxinas extinguieron a cualquiera que lo hiciera.
				Fue él el responsable del Lodazal: nacido de sus toxinas, asfixiando a la civilización que una vez llamó hogar a esa región.
				Ten cuidado, tu victoria aquí es solo temporal. El alma colérica de Yamata aún persiste.
				Y temo que su verdadero poder aún duerme... Esperando a ser despertado.
				'''
		}

		ZeroLore: {
			DisplayName: Cero
			Tooltip: ""
			Lore:
				'''
				El Constructo del Apocalipsis...
				Draedon había estado fascinado por esta unidad durante mucho tiempo. Sus escudos repelieron cada uno de sus intentos de romperlos.
				Parece que solo tú fuiste capaz de activarlo.
				Ten cautela.
				Esa señal de auxilio, si la investigación de Draedon sobre esa anomalía es de creer...
				Has invitado al desastre a nuestra puerta.
				'''
		}

		ChampionRajahRabbitLore: {
			DisplayName: El Campeón de los Inocentes
			Tooltip: ""
			Lore:
				'''
				Había pensado que el tiempo de Rajah como Campeón de los Inocentes me sobreviviría por mucho, pero me equivoqué.
				Ahora, tú llevas su título, y él se retira a un lado tal como lo he hecho yo.
				Vencerlo a su máximo poder no es una hazaña pequeña; puede que ya estés listo para enfrentarte incluso a mí.
				Sal victorioso en tus próximas batallas, y ese momento pronto estará al caer.
				'''
		}

		ShenDoragonLore: {
			DisplayName: Shen Doragon
			Tooltip: ""
			Lore:
				'''
				Pensar que Akuma y Yamata no eran más que dos mitades de un solo ser...
				Aun así, no puedo evitar dudar de que eso fuera todo de lo que era capaz.
				En relatos antiguos, he oído la historia de un héroe que luchó contra el Discordia Encarnado.
				Sin embargo, ese relato no describía a un dragón, sino a un hombre... Qué curioso...
				'''
		}

		InfinityZeroLore: {
			DisplayName: Cero Infinito
			Tooltip: ""
			Lore:
				'''
				El conocimiento sobre el Asesino del Infinito era el límite al que llegaba la investigación de Draedon sobre la anomalía.
				Pensar que era así de poderoso, y que no era más que un caparazón para una amenaza aún mayor.
				Olvido... Temo haber oído ese nombre una vez antes, en escrituras antiguas que describen la creación de nuestro universo.
				Cuatro Titanes de poder inconmensurable...
				¿Podría ser esta la encarnación de la Entropía de la que hablaban...?
				'''
		}

		SoulOfCthulhuLore: {
			DisplayName: Alma De Cthulhu
			Tooltip: ""
			Lore:
				'''
				La caída de los dragones... ¿Podría ser que no hubiera solo un coloso aberrante, sino dos...?
				Si se ha de creer a ese espíritu de otro mundo, entonces ese debe haber sido el caso, pero ¿por qué se me ocultaría la historia de este...?
				En mis estudios de la lengua de los Dragones, aprendí que 'Cthulhu' significa 'Gran Bestia'.
				Tal vez fue este gemelo el que inspiró ese apodo...
				'''
		}
	}
}

InfinityGauntlet: {
	DisplayName: Guantelete del Infinito
	Tooltip: ""
}

TimeStone: {
	DisplayName: Gema del Tiempo
