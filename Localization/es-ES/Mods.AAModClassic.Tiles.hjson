	MapEntry: Reloj de la Perdición

	FlavorText: {
		PreZero:
			'''
			El reloj está haciendo la cuenta regresiva hacia algo... aunque no estás seguro de qué.
			El número en este momento es tan alto que ni siquiera sabes cómo se llama.
			'''
		PostZero: El reloj muestra un solo dígito: 0
	}
}

