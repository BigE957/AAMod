AleisterBook: {
	DisplayName: Libro de Aleister
	Tooltip:
		'''
		Un libro legendario de la Gran Bestia Mega Therion.
		Aumenta en un 10% el daño de invocación
		Aumenta en 2 el número máximo de súbditos que puedes tener
		¿Tal vez podrías hacerlo más fuerte..?
		Hay una nota escrita en la portada:
		Necesito almas más poderosas, *****,*********,**********
		'''
}

TheBookOfTheLaw: {
	DisplayName: El Libro de la Ley
	Tooltip:
		'''
		Un libro legendario de la Gran Bestia Mega Therion.
		Aumenta en un 30% el daño de invocación
		Aumenta en 2 el número máximo de súbditos que puedes tener
		Incluye los efectos de todas las piezas utilizadas para fabricarlo.

		'''
}

